{
  "name": "eslint-config-any",
  "version": "0.0.0",
  "description": "ESLint configuration for JavaScript, TypeScript, React, Next.js & Vue projects, by Julio L. Muller",
  "license": "MIT",
  "author": {
    "name": "Julio L. Muller",
    "url": "https://github.com/juliolmuller"
  },
  "keywords": [
    "eslint",
    "config",
    "javascript",
    "typescript",
    "node",
    "react",
    "next",
    "next.js",
    "vue",
    "jest",
    "vitest",
    "commonjs"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LacusSolutions/eslint-config-any.git"
  },
  "bugs": {
    "url": "https://github.com/LacusSolutions/eslint-config-any/issues"
  },
  "homepage": "https://github.com/LacusSolutions/eslint-config-any#readme",
  "engines": {
    "node": ">=22",
    "bun": ">=1.4"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prepare": "husky",
    "commit": "commit",
    "lint": "eslint src/ eslint.config.js"
  },
  "peerDependencies": {
    "eslint": "^10.3.0",
    "next": "^16.0.0",
    "typescript": ">=5.8.0 <6.1.0"
  },
