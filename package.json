    "next": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "~4.8.1",
    "@eslint-react/eslint-plugin": "~5.20.8",
    "@eslint-react/kit": "~5.20.8",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "~2.1.0",
    "@eslint/markdown": "~8.0.3",
    "@next/eslint-plugin-next": "~16.3.6",
    "@stylistic/eslint-plugin": "~5.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-array-func": "~5.1.1",
    "eslint-plugin-import-helpers": "~2.0.2",
    "eslint-plugin-import-x": "~4.17.1",
    "eslint-plugin-jsx-a11y-x": "~0.2.0",
    "eslint-plugin-perfectionist": "~5.12.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-regexp": "~3.3.1",
    "eslint-plugin-vue": "~10.11.1",
    "globals": "^17.12.0",
    "prettier": "~3.9.9",
    "prettier-plugin-jsdoc": "~1.8.1",
    "typescript-eslint": "~8.70.1",
    "vue-eslint-parser": "^10.4.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/prompt-cli": "^21.2.3",
    "@types/bun": "^1.4.2",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "eslint": "^10.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "typescript": "~6.0.3"
  }
